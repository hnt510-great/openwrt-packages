#!/bin/sh /etc/rc.common
# Copyright (C) 2006 OpenWrt.org
START=61

# The native manager owns the daemon. rc.d remains for recovery boots.
if [ -z "$IPKG_INSTROOT" ] && [ -d /run/systemd/system ] &&
   [ -f /usr/lib/systemd/system/avahi-daemon.service ]; then
	case "$action" in
		boot|shutdown) exit 0 ;;
		help|depends) ;;
		*) exec /usr/libexec/avahi-daemon-systemd "$action" "$@" ;;
	esac
fi

USE_PROCD=1
PROG=avahi-daemon

start_service() {
	procd_open_instance
	procd_set_param command "$PROG"
	procd_append_param command -s
	procd_set_param respawn
	procd_close_instance
}

reload_service() {
	procd_send_signal "$PROG"
}
