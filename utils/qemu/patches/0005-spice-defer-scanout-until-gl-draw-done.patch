Subject: ui/spice: defer scanout replacement until GL draw completion

The display reset/modeset path can replace or disable a scanout while
spice-server still has a GL draw cookie outstanding. The server aborts in
spice_qxl_gl_scanout(). Retain/coalesce exported scanout fds, apply the latest
scanout from the completion BH before unblocking the renderer, and close
superseded or shutdown-pending fds. Do not fake completion or disable GL.

--- a/ui/spice-display.c
+++ b/ui/spice-display.c
@@ -785,11 +785,37 @@
 
 #ifdef HAVE_SPICE_GL
 
+/* QEMU may reset/change scanout while the client still owns a GL draw. */
+struct SpiceGLScanout {
+    int fd[DMABUF_MAX_PLANES];
+    uint32_t width, height;
+    uint32_t offset[DMABUF_MAX_PLANES], stride[DMABUF_MAX_PLANES];
+    uint32_t num_planes, format;
+    uint64_t modifier;
+    int y_0_top;
+    bool have_monitor_config;
+    int monitor_x, monitor_y, monitor_width, monitor_height;
+};
+
+static void spice_gl_apply_pending_scanout(SimpleSpiceDisplay *ssd);
+static void spice_gl_discard_pending_scanout(SimpleSpiceDisplay *ssd);
+
 static void qemu_spice_gl_monitor_config(SimpleSpiceDisplay *ssd,
                                          int x, int y, int w, int h)
 {
     QXLMonitorsConfig *config;
     QXLCookie *cookie;
+
+    if (ssd->pending_scanout) {
+        struct SpiceGLScanout *scanout = ssd->pending_scanout;
+
+        scanout->have_monitor_config = true;
+        scanout->monitor_x = x;
+        scanout->monitor_y = y;
+        scanout->monitor_width = w;
+        scanout->monitor_height = h;
+        return;
+    }
 
     config = g_malloc0(sizeof(QXLMonitorsConfig) + sizeof(QXLHead));
     config->count = 1;
@@ -826,6 +852,8 @@
 {
     SimpleSpiceDisplay *ssd = opaque;
 
+    ssd->gl_draw_pending = false;
+    spice_gl_apply_pending_scanout(ssd);
     qemu_spice_gl_block(ssd, false);
 }
 
@@ -840,6 +868,7 @@
     uint64_t cookie;
 
     cookie = (uintptr_t)qxl_cookie_new(QXL_COOKIE_TYPE_GL_DRAW_DONE, 0);
+    ssd->gl_draw_pending = true;
     spice_qxl_gl_draw_async(&ssd->qxl, x, y, w, h, cookie);
 }
 
