config irqbalance 'irqbalance'
	option enabled '0'

	# Level at which irqbalance partitions cache domains.
	# Default is 2 (L2$).
	#option deepestcache '2'

	# The default value is 10 seconds
	#option interval '10'

	# Specify excluded cpulist
	#option banned_cpulist '0'

	# List of IRQ's to ignore
	#list banirq '36'
	#list banirq '69'


	# Optional PCI network-interface CPU pools (shell wildcard + CPU list).
	# Rules are intersected when more than one matches. Unmatched IRQs are unchanged.
	#list netdev_cpus 'enp*:0-3,8-11'
