#!/bin/sh /etc/rc.common

START=99


USE_PROCD=1
. "$IPKG_INSTROOT/usr/libexec/wsdd2-config.sh"

start_service() {
	# needs long delay, otherwise service may not register correctly on stratup/reboot (not sure what the issues is?)
	sleep 5

	wsdd2_find_conf || {
		logger -p daemon.info -t 'wsdd2' "samba36/4 or ksmbd is not running"
		return
	}

	wsdd2_resolve_params

	procd_open_instance
	procd_set_param command /usr/bin/wsdd2
	[ -n "$WS_IFNAME" ] && procd_append_param command -i "$WS_IFNAME"
	procd_append_param command -N "$WS_NB"
	procd_append_param command -G "$WS_WG"
	[ -z "$WS_BI" ] || procd_append_param command -b "$WS_BI"
	procd_set_param respawn
	procd_set_param file "$WS_CONF"
	procd_close_instance
}

service_triggers() {
	# PROCD_RELOAD_DELAY=1000
	procd_add_reload_trigger "dhcp" "system" "samba" "samba4" "ksmbd"
}
