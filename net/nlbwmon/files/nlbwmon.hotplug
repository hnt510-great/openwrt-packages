#!/bin/sh

if [ -d /run/systemd/system ] && [ -f /usr/lib/systemd/system/nlbwmon.service ]; then
	case "$ACTION" in
		ifup|ifupdate)
			systemctl is-active --quiet nlbwmon.service || exit 0
			/usr/libexec/nlbwmon-systemd interface "$INTERFACE" || exit 0
			systemctl --no-block start nlbwmon-reconfigure.service
			;;
	esac
	exit 0
fi

[ -n "$DEVICE" ] || exit 0

[ "$ACTION" = ifup ] && /etc/init.d/nlbwmon enabled && {
	/etc/init.d/nlbwmon reload
	logger -t nlbwmon "Reloading nlbwmon due to $ACTION of $INTERFACE ($DEVICE)"
}
