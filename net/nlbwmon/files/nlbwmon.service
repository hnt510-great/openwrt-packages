[Unit]
Description=OpenWrt Traffic Usage Monitor
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
Slice=auxiliary.slice
Nice=19
ExecStart=/usr/libexec/nlbwmon-systemd run
Restart=on-failure
RestartSec=5s
KillMode=control-group
TimeoutStopSec=30s

[Install]
WantedBy=multi-user.target
Also=nlbwmon-config.path
