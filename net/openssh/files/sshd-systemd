#!/bin/sh
# Package lifecycle only; never transfers a running listener out of procd.
set -eu

root=${IPKG_INSTROOT:-}
case "${1:-}" in
postinst)
	if [ -n "$root" ]; then
		# Offline image assembly must not contact the host's service manager.
		[ "${PKG_UPGRADE:-0}" != 1 ] || exit 0
		[ "$(readlink "$root/etc/systemd/system/sshd.service" 2>/dev/null || :)" != /dev/null ] || exit 0
		wants=$root/etc/systemd/system/multi-user.target.wants
		mkdir -p "$wants"
		if [ ! -e "$wants/sshd.service" ] && [ ! -L "$wants/sshd.service" ]; then
			ln -s /usr/lib/systemd/system/sshd.service "$wants/sshd.service"
		fi
		exit 0
	fi
	[ -d /run/systemd/system ] || exit 0
	systemctl daemon-reload
	for mask in /etc/systemd/system/sshd.service /run/systemd/system/sshd.service; do
		[ "$(readlink "$mask" 2>/dev/null || :)" != /dev/null ] || exit 0
	done
	# Online upgrades stage a procd-to-systemd migration for an explicit reboot.
	# try-restart preserves inactive/disabled units and cannot start a second owner.
	if [ "${PKG_UPGRADE:-0}" != 1 ] &&
	   [ "$(readlink /etc/systemd/system/sshd.service 2>/dev/null || :)" != /dev/null ]; then
		systemctl enable sshd.service
	fi
	systemctl try-restart sshd.service
	;;
prerm)
	[ -z "$root" ] && [ -d /run/systemd/system ] || exit 0
	[ "${PKG_UPGRADE:-0}" != 1 ] || exit 0
	systemctl stop sshd.service
	systemctl disable sshd.service
	;;
*) exit 2 ;;
esac
