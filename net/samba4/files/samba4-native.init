#!/bin/sh
# OpenWrt native service adapter
case "$1" in
	boot|shutdown|depends) exit 0 ;;
esac
if [ -n "${IPKG_INSTROOT:-}" ]; then
	case "$1" in
		enabled) exec systemctl --root="$IPKG_INSTROOT" is-enabled samba4.service ;;
		enable|disable) exec systemctl --root="$IPKG_INSTROOT" "$1" samba4.service ;;
		*) exit 0 ;;
	esac
fi
exec /usr/libexec/samba4-systemd "$@"
